
# hook make
#   note <Create a new deck repository>
#   take name
#   take head
#     lead <-t>
#     lead <--title>
#   task make-deck

mine hook
  mine term, term hook
    slot name
    mine maybe
      mine term, term note
        mine text
          slot note
    mine list
      mine form, like hook-take
        slot take
    mine maybe
      mine term, term task
        mine text
          slot task

mine hook-take
  mine term, term take
    slot name
    mine list
      mine form, like hook-take-lead
        slot lead

mine hook-take-lead
  mine term, term lead
    mine text
      slot flag
