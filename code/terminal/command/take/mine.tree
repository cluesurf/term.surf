
load @cluesurf/term/code/code/seed/mine
  find seed

load @cluesurf/term/code/terminal/command/mill/mine
  find tool-mill

mine tool-take
  mine term, term take
    mine term
      slot name
    mine maybe
      mine term, term code
        mine term
          slot code
    mine maybe
      mine form, like tool-take-like
        slot like
    mine maybe
      mine form, like tool-take-list
        slot list
    mine maybe
      mine term, term need
        mine term
          slot need
    mine maybe
      mine term, term base
        mine any
          mine form, like seed
            slot base
          mine term
            slot base-term
    mine list
      mine form, like tool-take-case
        slot case
    mine maybe
      mine form, like tool-mill
        slot mill
    mine maybe
      mine form, like tool-take-seed
        slot seed
    mine maybe
      mine form, like tool-take-mark
        slot mark

mine tool-take-like
  mine term, term like
    mine term
      slot name

mine tool-take-list
  mine term, term list
    mine term
      slot name

mine tool-take-case
  mine term, term case
    mine term
      slot name

mine tool-take-seed
  mine any
    mine form, like tool-take-seed-env
      slot env
    mine form, like tool-take-seed-call
      slot call

mine tool-take-seed-env
  mine term, term seed
    mine term, term env
      mine text
        slot name

mine tool-take-seed-call
  mine term, term seed
    mine term, term call
      mine form, like tool-take-seed-call-bind
        slot call

mine tool-take-seed-call-bind
  mine term, term call
    mine term
      slot name

mine tool-take-mark
  mine any
    mine form, like tool-take-mark-private
      slot private
    mine form, like tool-take-mark-deprecated
      slot deprecated
    mine form, like tool-take-mark-experimental
      slot experimental

mine tool-take-mark-private
  mine term, term mark
    mine term, term private

mine tool-take-mark-deprecated
  mine term, term mark
    mine term, term deprecated
      mine maybe
        mine form, like tool-take-mark-deprecated-call
          slot call

mine tool-take-mark-deprecated-call
  mine term, term call
    mine term
      slot name

mine tool-take-mark-experimental
  mine term, term mark
    mine term, term experimental
