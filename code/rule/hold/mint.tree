
load @cluesurf/term/code/code/call/mint
  find call

mint hold, like hold
  case name
    slot name
  case claim, mint call
    slot claim
  case step, mint step
    slot step
  hook make
    make hold
      bind name, read name
      bind claim, read claim
      bind step, read step

mint step
  case melt, mint melt
    slot melt
  case calm, mint calm
    slot calm
  case cite, mint cite
    slot cite
  case turn, mint turn
    slot turn
  case take, mint take
    slot take
  case find, mint find
    slot find
  case self, mint self
    slot self
  case seed, mint seed
    slot seed
  case rest, mint rest
    slot rest
  case weld, mint weld
    slot weld
  case link, mint link
    slot link
  case have, mint have
    slot have

mint melt, like melt
  case arg
    slot arg
  hook make
    make melt
      bind arg, read arg

mint calm, like calm
  case arg
    slot arg
  hook make
    make calm
      bind arg, read arg

mint cite, like cite
  case arg
    slot arg
  hook make
    make cite
      bind arg, read arg

mint turn, like turn
  case arg
    slot arg
  hook make
    make turn
      bind arg, read arg

mint take, like take
  case arg
    slot arg
  hook make
    make take
      bind arg, read arg

mint find, like find
  case arg
    slot arg
  hook make
    make find
      bind arg, read arg

mint self, like self
  case arg
    slot arg
  case step, mint step
    slot step
  hook make
    make self
      bind arg, read arg
      bind step, read step

mint seed, like seed
  case arg
    slot arg
  case step, mint step
    slot step
  hook make
    make seed
      bind arg, read arg
      bind step, read step

mint rest, like rest
  case arg
    slot arg
  case step, mint step
    slot step
  hook make
    make rest
      bind arg, read arg
      bind step, read step

mint weld, like weld
  case arg
    slot arg
  case step, mint step
    slot step
  hook make
    make weld
      bind arg, read arg
      bind step, read step

mint link, like link
  case arg
    slot arg
  case step, mint step
    slot step
  hook make
    make link
      bind arg, read arg
      bind step, read step

mint have, like have
  case arg
    slot arg
  case step, mint step
    slot step
  hook make
    make have
      bind arg, read arg
      bind step, read step
