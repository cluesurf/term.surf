
mint task, like task
  case name
    slot name
  case head, mint head
    slot head
  case base, mint base
    slot base
  case flow, mint flow
    slot flow
  case task, mint task
    slot task
  case like, mint like
    slot like
  case wait
    slot wait
  case risk
    slot risk
  case hide
    slot hide
  hook make
    make task
      bind name, read name
      bind head, read head
      bind base, read base
      bind flow, read flow
      bind task, read task
      bind like, read like
      bind wait, read wait
      bind risk, read risk
      bind hide, read hide

mint head
  case name
    slot name
  case form, mint form
    slot form
  case fall
    slot fall
  hook make
    make head
      bind name, read name
      bind head-form, read form
      bind fall, read fall

mint base
  case name
    slot name
  case form, mint form
    slot form
  case fall
    slot fall
  hook make
    make base
      bind name, read name
      bind link-form, read form
      bind fall, read fall

mint flow
  case call, mint call
    slot call
  case make, mint make
    slot make
  case save, mint save
    slot save
  case fork, mint fork
    slot fork
  case walk, mint walk
    slot walk
  case back, mint back
    slot back
  case meet, mint meet
    slot meet
  case turn, mint turn
    slot turn
  case next
    slot next
  case rest
    slot rest
  case rein
    slot rein
  case show, mint show
    slot show
  case dive, mint dive
    slot dive
  case hint, mint hint
    slot hint
  case tell, mint tell
    slot tell
  case bust, mint bust
    slot bust
  case halt, mint halt
    slot halt
  case fuse, mint fuse
    slot fuse
  case slot, mint slot
    slot slot
  case beam, mint beam
    slot beam

mint show
  case sift, mint sift
    slot sift
  hook make
    make show
      bind sift, read sift

mint dive
  case sift, mint sift
    slot sift
  hook make
    make dive
      bind sift, read sift

mint hint
  case sift, mint sift
    slot sift
  hook make
    make hint
      bind sift, read sift

mint tell
  case sift, mint sift
    slot sift
  hook make
    make tell
      bind sift, read sift

mint bust
  case sift, mint sift
    slot sift
  hook make
    make bust
      bind sift, read sift

mint halt
  case mode
    slot mode
  case sift, mint sift
    slot sift
  hook make
    make halt
      bind mode, read mode
      bind sift, read sift

mint save
  case name
    slot name
  case sift, mint sift
    slot sift
  hook make
    make save
      bind name, read name
      bind sift, read sift

mint turn
  case name
    slot name
  case sift, mint sift
    slot sift
  case line
    slot line
  hook make
    make turn
      bind name, read name
      bind sift, read sift
      bind line, read line

mint back
  case sift, mint sift
    slot sift
  hook make
    make back
      bind sift, read sift
