
mint task, like task
  case name
    slot name
  case head, mint head
    slot head
  case take, mint take
    slot take
  case flow, mint flow
    slot flow
  case task, mint task
    slot task
  case like, mint like
    slot like
  case wait
    slot wait
  case risk
    slot risk
  case hide
    slot hide
  case firm
    slot firm
  case note, mint note
    slot note
  hook make
    make task
      bind name, read name
      bind head, read head
      bind take, read take
      bind flow, read flow
      bind task, read task
      bind like, read like
      bind wait, read wait
      bind risk, read risk
      bind hide, read hide
      bind firm, read firm
      bind note, read note

mint head
  case name
    slot name
  case form, mint form
    slot form
  case fall
    slot fall
  hook make
    make head
      bind name, read name
      bind head-form, read form
      bind fall, read fall

mint take
  case name
    slot name
  case like, mint like
    slot like
  case base, mint seed
    slot base
  hook make
    make take
      bind name, read name
      bind like, read like
      bind base, read base

mint flow
  case call, mint call
    slot call
  case make, mint make
    slot make
  case save, mint save
    slot save
  case fork, mint fork
    slot fork
  case walk, mint walk
    slot walk
  case back, mint back
    slot back
  case meet, mint meet
    slot meet
  case turn, mint turn
    slot turn
  case next
    slot next
  case rest
    slot rest
  case rein
    slot rein
  case show, mint show
    slot show
  case dive, mint dive
    slot dive
  case hint, mint hint
    slot hint
  case tell, mint tell
    slot tell
  case bust, mint bust
    slot bust
  case halt, mint halt
    slot halt
  case fuse, mint fuse
    slot fuse
  case slot, mint slot
    slot slot
  case beam, mint beam
    slot beam

mint show
  case seed, mint seed
    slot seed
  hook make
    make show
      bind seed, read seed

mint dive
  case seed, mint seed
    slot seed
  hook make
    make dive
      bind seed, read seed

mint hint
  case seed, mint seed
    slot seed
  hook make
    make hint
      bind seed, read seed

mint tell
  case seed, mint seed
    slot seed
  hook make
    make tell
      bind seed, read seed

mint bust
  case seed, mint seed
    slot seed
  hook make
    make bust
      bind seed, read seed

mint halt
  case mode
    slot mode
  case seed, mint seed
    slot seed
  hook make
    make halt
      bind mode, read mode
      bind seed, read seed

mint save
  case name
    slot name
  case seed, mint seed
    slot seed
  hook make
    make save
      bind name, read name
      bind seed, read seed

mint turn
  case name
    slot name
  case seed, mint seed
    slot seed
  case line
    slot line
  hook make
    make turn
      bind name, read name
      bind seed, read seed
      bind line, read line

mint back
  case seed, mint seed
    slot seed
  hook make
    make back
      bind seed, read seed
