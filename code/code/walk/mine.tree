load @cluesurf/term/code/code/seed/mine
  find seed

load @cluesurf/term/code/code/bind/mine
  find bind

mine walk
  mine term, term walk
    mine maybe
      mine term
        slot mode
    mine maybe
      mine form, like seed
        slot seed
    mine list
      mine form, like bind
        slot bind
    mine list
      mine form, like hook
        slot hook

mine hook
  mine term, term hook
    mine term
      slot name
    mine list
      mine form, like base
        slot base
    mine list
      mine form, like flow
        slot flow
