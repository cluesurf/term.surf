
mint cast
  case name
    slot name
  case deed
    slot deed
  case line
    slot line
  case sort
    slot sort
  case take
    slot take
  case loot
    slot loot
  hook make
    make cast
      bind name, read name
      bind deed, read deed
      bind line, read line
      bind sort, read sort
      bind take, read take
      bind loot, read loot
