
load @cluesurf/base/code/seed
  find seed

mint seed
  case name
    slot name
  case seed, mint seed
    slot seed
  case task, mint task
    slot task
  case make, mint make
    slot make
  case sift, mint sift
    slot sift
  hook make
    make seed
      bind name, read name
      bind seed, read seed
      bind task, read task
      bind make, read make
      bind sift, read sift
