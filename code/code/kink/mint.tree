
load @cluesurf/base/code/kink
  find kink-def
  find kink-link
  find kink-wear

mint kink, like kink-def
  case name
    slot name
  case head
    slot head
  case code
    slot code
  case hint
    slot hint
  case link, mint kink-link
    slot link
  case wear, mint kink-wear
    slot wear
  hook make
    make kink-def
      bind name, read name
      bind head, read head
      bind code, read code
      bind hint, read hint
      bind link, read link
      bind wear, read wear

mint kink-link, like kink-link
  case name
    slot name
  case like
    slot like
  case void
    slot void
  hook make
    make kink-link
      bind name, read name
      bind like, read like
      bind void, read void

mint kink-wear, like kink-wear
  case name
    slot name
  case task
    slot task
  hook make
    make kink-wear
      bind name, read name
      bind task, read task
