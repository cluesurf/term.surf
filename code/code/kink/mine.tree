
# kink syntax-error
#   head <Syntax error>
#   code 1
#   hint <To fix this...>
#   link text, like text
#   link show, void text
#   wear fill
#     task fill
#       take self

mine kink
  mine term, term kink
    take name
    mine maybe
      mine term, term head
        mine text
          take head
    mine maybe
      mine term, term code
        take code
    mine maybe
      mine term, term hint
        mine text
          take hint
    mine list
      mine form, form kink-link
        take link
    mine list
      mine form, form kink-wear
        take wear

mine kink-link
  mine term, term link
    take name
    mine case
      mine form, form kink-link-like
        take like
      mine form, form kink-link-void
        take void

mine kink-link-like
  mine term, term like
    mine text
      take type

mine kink-link-void
  mine term, term void
    mine text
      take type

mine kink-wear
  mine term, term wear
    take name
    mine list
      mine form, form task
        take task
