
load @cluesurf/term/code/code/task/mine
  find task

# kink syntax-error
#   head <Syntax error>
#   code 1
#   hint <To fix this...>
#   link text, like text
#   link show, void text
#   wear fill
#     task fill
#       take self

mine kink
  mine term, term kink
    slot name
    mine maybe
      mine term, term head
        mine text
          slot head
    mine maybe
      mine term, term code
        slot code
    mine maybe
      mine term, term hint
        mine text
          slot hint
    mine list
      mine form, like kink-link
        slot link
    mine list
      mine form, like kink-wear
        slot wear

mine kink-link
  mine term, term link
    slot name
    mine case
      mine form, like kink-link-like
        slot like
      mine form, like kink-link-void
        slot void

mine kink-link-like
  mine term, term like
    mine text
      slot type

mine kink-link-void
  mine term, term void
    mine text
      slot type

mine kink-wear
  mine term, term wear
    slot name
    mine list
      mine form, like task
        slot task
