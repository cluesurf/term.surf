
load @cluesurf/term/code/code/bind/mine
  find bind

load @cluesurf/term/code/code/seed/mine
  find seed

mine call
  mine term, term call
    mine term
      slot name
    mine list
      mine form, like bind
        slot bind
    mine maybe
      mine case
        mine form, like save
          slot save
        mine form, like turn
          slot turn
    mine list
      mine form, like hook
        slot hook

mine hook
  mine term, term hook
    mine term
      slot name
    mine maybe
      mine form, like line
        slot line
    mine list
      mine form, like base
        slot base
    mine list
      mine form, like flow
        slot flow
    mine list
      mine form, like task
        slot task

mine line
  mine term, term line
    mine term
      slot name
