
mint tool-seed
  case code, mint tool-seed-code
    slot code
  case policy, mint tool-seed-policy
    slot policy

mint tool-seed-code
  case case, mint tool-seed-code-case
    slot case
  hook make
    make tool-seed-code
      bind case, read case

mint tool-seed-code-case
  case name
    slot name
  case value
    slot value
  hook make
    make tool-seed-code-case
      bind name, read name
      bind value, read value

mint tool-seed-policy
  case name
    slot name
  case value
    slot value
  hook make
    make tool-seed-policy
      bind name, read name
      bind value, read value
