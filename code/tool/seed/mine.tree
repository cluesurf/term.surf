
mine tool-seed
  mine any
    mine form, like tool-seed-code
      slot code
    mine form, like tool-seed-policy
      slot policy

mine tool-seed-code
  mine term, term seed
    mine term, term code
      mine list
        mine form, like tool-seed-code-case
          slot case

mine tool-seed-code-case
  mine term, term seed
    mine term
      slot name
    mine term, term mark
      mine term
        slot value

mine tool-seed-policy
  mine term, term seed
    mine term
      slot name
    mine term
      slot value
