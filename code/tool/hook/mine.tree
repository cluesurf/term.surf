
load @cluesurf/term/code/code/call/mine
  find call

mine tool-hook
  mine any
    mine form, like tool-hook-boot
      slot boot
    mine form, like tool-hook-halt
      slot halt

mine tool-hook-boot
  mine term, term hook
    mine term, term boot
      mine list
        mine form, like call
          slot call

mine tool-hook-halt
  mine term, term hook
    mine term, term halt
      mine list
        mine form, like call
          slot call
