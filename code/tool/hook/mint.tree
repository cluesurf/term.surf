
load @cluesurf/term/code/code/call/mint
  find call

mint tool-hook
  case boot, mint tool-hook-boot
    slot boot
  case halt, mint tool-hook-halt
    slot halt

mint tool-hook-boot
  case call, mint call
    slot call
  hook make
    make tool-hook-boot
      bind call, read call

mint tool-hook-halt
  case call, mint call
    slot call
  hook make
    make tool-hook-halt
      bind call, read call
